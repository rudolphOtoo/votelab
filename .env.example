APP_NAME=VoteLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite for local development. Production runs PostgreSQL 17 (README, "Database"):
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=votelab
# DB_USERNAME=votelab
# DB_PASSWORD=

# Production: redis (README, "Cache, locks and logs").
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Production: redis, with persistence on and maxmemory-policy noeviction (README).
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Trusted proxies (config/trustedproxy.php) ---
# Peers allowed to set the client IP/scheme via X-Forwarded-For/-Proto/-Port. Client IPs feed voter
# fingerprints and rate limits, so keep this tight. Comma-separated IPs or CIDR ranges; empty trusts none.
# Behind a load balancer: its private address or subnet, e.g. 10.0.0.0/16.
# Behind Cloudflare: list Cloudflare's published ranges (https://www.cloudflare.com/ips/) and keep them
# current; with "*" a voter can prepend a fake X-Forwarded-For entry. Use "*" only when the origin is
# firewalled to the proxy and that proxy overwrites (not appends to) X-Forwarded-For.
TRUSTED_PROXIES=

# --- Payments (PayZephyr / Paystack) ---
# Use test keys (sk_test_..., pk_test_...) outside production. Never commit real keys.
PAYMENTS_DEFAULT_PROVIDER=paystack
PAYMENTS_FALLBACK_PROVIDER=
PAYMENTS_DEFAULT_CURRENCY=GHS
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_ENABLED=true
# VoteLab's vote_transactions table is the ledger; PayZephyr's own transaction log is off.
PAYMENTS_LOGGING_ENABLED=false
PAYMENTS_LOG_CHANNEL=payments
# storage/logs/payments-*.log: every payment decision (ids, amounts, statuses; never payloads or emails).
LOG_PAYMENTS_LEVEL=info
LOG_PAYMENTS_DAYS=90

# --- Organizers (config/organizations.php) ---
# Hours an emailed invitation link stays valid (signed, single-use).
ORGANIZER_INVITATION_TTL_HOURS=72
# Days owners and admins have, from their first sign-in, to turn on two-factor before the dashboard locks.
ORGANIZER_TWO_FACTOR_GRACE_DAYS=7
# Disk for nominee photos (cropped 4:5, WebP). Must be publicly readable.
NOMINEE_PHOTO_DISK=public
# Private disk for uploaded originals (kept for re-cropping). Must NOT be publicly readable.
NOMINEE_PHOTO_ORIGINAL_DISK=local
# Days storage/logs/audit-*.log (invitations, membership changes) is kept.
LOG_AUDIT_DAYS=365

# --- Voting (config/voting.php) ---
# storage/logs/voting-*.log: free votes cast and refused, tally drift (voter keys and IPs only as keyed hashes).
LOG_VOTING_LEVEL=info
LOG_VOTING_DAYS=30
VOTING_CURRENCY=GHS
VOTING_MAX_VOTES_PER_ORDER=10000
# Minutes after a close during which payments started before it are still credited (if before the reveal).
VOTING_CLOSE_GRACE_MINUTES=30
VOTING_PROXY_EMAIL_DOMAIN=voters.votelab.example
VOTING_LEADERBOARD_CACHE_SECONDS=3
# Dedicated key for voter fingerprints (free-vote limits, hashed IPs). REQUIRED in production: the app refuses to
# boot without it. Never APP_KEY; outside production a fixed test key is used. Generate with:
# php -r "echo base64_encode(random_bytes(32));". Rotating it resets every voter's daily free votes.
VOTING_FINGERPRINT_KEY=
# Dedicated key for phone_hash (exact search by payer phone; the number itself is never stored). REQUIRED in
# production: the app refuses to boot without it. Never APP_KEY; outside production a fixed test key is used.
# Generate with: php -r "echo base64_encode(random_bytes(32));". Rotating it breaks phone search on
# every existing transaction (old hashes no longer match); set it once, before launch, and keep it.
VOTING_PHONE_HASH_KEY=
VOTING_VOTER_COOKIE=vl_voter
VOTING_RATE_CHECKOUT_PER_VOTER=5
VOTING_RATE_CHECKOUT_PER_IP=600
VOTING_RATE_CHECKOUT_PER_NOMINEE=1200
VOTING_RATE_FREE_VOTE_PER_VOTER=10
VOTING_RATE_FREE_VOTE_PER_IP=1200
# Per minute. *_PER_VOTER / *_PER_DEVICE are per browser (device cookie); *_PER_IP are per-network backstops,
# kept high because carrier-grade NAT and venue Wi-Fi put hundreds of voters on one IP (D-105).
VOTING_RATE_PUBLIC_PAGES_PER_DEVICE=120
VOTING_RATE_PUBLIC_PAGES_PER_IP=3000
VOTING_RATE_CALLBACK_PER_DEVICE=30
VOTING_RATE_CALLBACK_PER_IP=3000
# Nominee share images (cached after first render), stage screen loads + polls, Paystack webhooks.
VOTING_RATE_SHARE_IMAGES_PER_IP=600
VOTING_RATE_STAGE_PER_IP=120
VOTING_RATE_WEBHOOK_PER_IP=1200
VOTING_PAYSTACK_FEE_BPS=195
VOTING_PAYSTACK_BEARER=subaccount
VOTING_SWEEPER_VERIFY_AFTER_MINUTES=10
VOTING_SWEEPER_EXPIRE_AFTER_HOURS=24
VOTING_SWEEPER_BATCH_SIZE=500
VOTING_REFERENCE_PREFIX=VL
VOTING_FULFILMENT_LOCK_SECONDS=30
VOTING_FULFILMENT_LOCK_WAIT_SECONDS=5

# --- Health (GET /health) ---
# Monitors sending this in an X-Health-Token header see which checks failed, queue depth and the scheduler
# heartbeat; everyone else gets only {"status": "ok|degraded|down"}. Use a long random value; empty = no details.
HEALTH_CHECK_TOKEN=

# --- Error tracking (config/sentry.php) ---
# Sentry DSN; leave empty to disable (local, tests). Phone numbers and emails are scrubbed before sending.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Tags every event; empty uses APP_ENV. Set SENTRY_RELEASE per deploy (e.g. the git commit) to tell releases apart.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Days storage/logs/alerts-*.log (failed jobs, fulfilment.gave_up, tally drift) is kept.
LOG_ALERTS_DAYS=90
